DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=
DEBUG=True

DB_NAME=to_do_app
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# uv run python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (Apple/Google/Mozilla). Must be mailto: or https:, not localhost.
VAPID_SUBJECT=mailto:you@example.com

# Secret for the scheduler calling /api/push/send-due/ (leave empty locally; use send_reminders --loop)
CRON_SECRET=

# Production only: the frontend's URL(s), allowed to call login/refresh/logout (comma-separated)
TRUSTED_FRONTEND_ORIGINS=
# Lax if the frontend proxies /api on its own domain (recommended); None if it calls the API domain directly
REFRESH_COOKIE_SAMESITE=Lax

# Email codes via Gmail: your Gmail address and a 16-character App Password (NOT your normal password).
# Leave empty in development: emails are written to server/.dev-emails/ instead.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Optional, e.g. "To-Do <you@gmail.com>" (must be the same Gmail address)
DEFAULT_FROM_EMAIL=

# Where the app is served (used in the welcome email button)
APP_URL=http://localhost:5173
